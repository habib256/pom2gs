  "tests": [
    {
      "id": "cpu65816-tom-harte",
      "title": "65C816 instruction vectors with cycle counts",
      "tier": "cycle",
      "readiness": "automated",
      "domains": ["cpu65816"],
      "asset_policy": "reference-only",
      "assets": [],
      "references": ["tom-harte-65816", "wdc-w65c816s"],
      "oracle": "Exact final registers, touched RAM and instruction cycle count, plus ordered address/data/VDA/VPA/VPB/RWB/E/M/X/MLB comparison for every active bus transaction. Inactive bus cycles are currently covered only by total count; MVN/MVP remain excluded and disputed corpus cases must become exact issue-linked xfails.",
      "requires": [
        {"path": "{build_dir}/tomharte_65816", "kind": "file"},
        {"path": "{tomharte_dir}", "kind": "directory"}
      ],
      "command": ["{build_dir}/tomharte_65816", "{tomharte_dir}", "--skip", "44,54"]
    },
    {
      "id": "fpi-mega2-local",
      "title": "Local fast/slow, shadowing and interrupt gates",
      "tier": "cycle",
      "readiness": "automated",
      "domains": ["fpi-cya", "mega2", "interrupts", "shadowing"],
      "asset_policy": "none",
      "assets": [],
      "references": ["mame-apple2gs"],
      "oracle": "CTest gates megaii_timing_test, speed_test, slowside_test, irq_test and hdd_test. The timing gate proves the 912-tick line arithmetic, active-access PH0 side-sync and conditional DRAM-refresh classification; inactive CPU-cycle placement and reset-phase calibration remain open.",
      "requires": [{"path": "{build_dir}", "kind": "directory"}],
      "command": ["ctest", "--test-dir", "{build_dir}", "-R", "^(megaii_timing_test|speed_test|slowside_test|irq_test|hdd_test)$", "--output-on-failure"]
    },
    {
      "id": "subsystems-local",
      "title": "Local VGC, ADB, SCC, DOC, IWM/Sony, SmartPort and RTC-adjacent gates",
      "tier": "unit",
      "readiness": "automated",
      "domains": ["vgc", "adb", "scc", "doc", "iwm-sony", "smartport", "rtc"],
      "asset_policy": "none",
      "assets": [],
      "references": ["mame-apple2gs", "clemens"],
      "oracle": "Current deterministic subsystem CTests; validates protocols and rendering primitives, not complete machine-cycle phase.",
      "requires": [{"path": "{build_dir}", "kind": "directory"}],
      "command": ["ctest", "--test-dir", "{build_dir}", "-R", "^(vgc_test|shr_test|dhgr_test|dhgr_page_test|text80_test|adb_test|scc_test|doc_test|iwm35_test|iwm525_test|smartport_test|disk35_test|twoimg_test)$", "--output-on-failure"]
    },
    {
      "id": "mister-custom-diagnostics",
      "title": "21 open bootable IIgs custom diagnostics",
      "tier": "external-open",
      "readiness": "staged",
      "domains": ["cpu65816", "fpi-cya", "mega2", "vgc", "interrupts", "shadowing", "adb", "scc", "doc", "iwm-sony", "rtc"],
      "asset_policy": "fetchable",
      "assets": [
        {
          "name": "Apple-IIgs_MiSTer pinned source archive",
          "path": "Apple-IIgs_MiSTer-9adbba8.tar.gz",
          "url": "https://github.com/MiSTer-devel/Apple-IIgs_MiSTer/archive/9adbba8622f378253765b7d438b6cbcc4d03fc57.tar.gz",
          "sha256": "09be754938c33b1b89addeeb46305a6ce7eb3c9b1ff21fae6be9caa0e5bd9572",
          "license": "GPL-3.0 upstream project; extracted/generated media remains ignored",
          "extract": {
            "format": "tar.gz",
            "prefix": "Apple-IIgs_MiSTer-9adbba8622f378253765b7d438b6cbcc4d03fc57/customtests",
            "destination": "mister-custom-diagnostics/customtests",
            "required": ["Makefile", "README.md", "blank.2mg"]
          }
        }
      ],
      "references": ["mister-iigs-tests", "mister-iigs-regression", "merlin32", "ciderpress2"],
      "oracle": "Each guest test prints PASS/FAIL; exact screenshot goldens are needed after adapting the disk build and input schedule to POMIIGS.",
      "members": [
        {"id": "mmu_test", "source": "MMU_TEST.S", "covers": "MMU, shadowing and language-card decode"},
        {"id": "gsqmmu_test", "source": "GSQMMU.S", "covers": "Independent RAMWRT, aux-bank and shadowing cases"},
        {"id": "scc_selftest", "source": "SELFTEST_SCC.S", "covers": "ROM selftest 06-01 SCC register sequence"},
        {"id": "scc_crosschan", "source": "SCC_CROSSCHAN_TEST.S", "covers": "UART serializer A-to-B and B-to-A paths"},
        {"id": "scc_both", "source": "SCC_BOTH_CHANNELS.S", "covers": "Three-byte receive FIFOs on both SCC channels"},
        {"id": "adb_device_enum", "source": "ADB_DEVICE_ENUM.S", "covers": "ADB GLU FLUSH/TALK absent-device handshake"},
        {"id": "adb_rom_checksum", "source": "ADB_ROM_CHECKSUM.S", "covers": "ROM 3 ADB microcontroller checksum"},
        {"id": "floppy_rw_test", "source": "FLOPPY_RW_TEST.S", "covers": "5.25- and 3.5-inch WOZ write/read/verify"},
        {"id": "time", "source": "TIME.S", "covers": "ProDOS GET_TIME and RTC driver"},
        {"id": "selftest01", "source": "SELFTEST01.S", "covers": "ROM diagnostic 01"},
        {"id": "selftest02", "source": "SELFTEST02.S", "covers": "ROM diagnostic 02"},
        {"id": "selftest03", "source": "SELFTEST03.S", "covers": "ROM diagnostic 03"},
        {"id": "selftest04", "source": "SELFTEST04.S", "covers": "ROM diagnostic 04"},
        {"id": "selftest05", "source": "SELFTEST05.S", "covers": "ROM diagnostic 05"},
        {"id": "selftest06", "source": "SELFTEST06.S", "covers": "ROM diagnostic 06"},
        {"id": "selftest07", "source": "SELFTEST07.S", "covers": "ROM diagnostic 07"},
        {"id": "selftest08", "source": "SELFTEST08.S", "covers": "ROM diagnostic 08"},
        {"id": "selftest09", "source": "SELFTEST09.S", "covers": "ROM diagnostic 09"},
        {"id": "selftest0a", "source": "SELFTEST0A.S", "covers": "ROM diagnostic 0A"},
        {"id": "selftest0b", "source": "SELFTEST0B.S", "covers": "ROM diagnostic 0B"},
        {"id": "selftest0c", "source": "SELFTEST0C.S", "covers": "ROM diagnostic 0C, Ensoniq sound"}
      ],
      "build": {
        "requires": [
          {"path": "{source_dir}/.pomiigs-source.json", "kind": "file"},
          {"name": "merlin_root", "kind": "variable"},
          {"name": "merlin32", "kind": "variable"},
          {"name": "cp2", "kind": "variable"},
          {"path": "{merlin_root}/Library", "kind": "directory"},
          {"path": "{merlin32}", "kind": "file"},
          {"path": "{cp2}", "kind": "file"}
        ],
        "command": [
          "make", "-C", "{source_dir}",
          "ASM={merlin32}", "MERLIN_DIR={merlin_root}",
          "CP2={cp2}", "CP2_DIR={cp2_dir}", "all"
        ],
        "outputs": [
          "{source_dir}/mmu_test.2mg",
          "{source_dir}/gsqmmu_test.2mg",
          "{source_dir}/scc_selftest.2mg",
          "{source_dir}/scc_crosschan.2mg",
          "{source_dir}/scc_both.2mg",
          "{source_dir}/adb_device_enum.2mg",
          "{source_dir}/adb_rom_checksum.2mg",
          "{source_dir}/floppy_rw_test.2mg",
          "{source_dir}/time.2mg",
          "{source_dir}/selftest01.2mg",
          "{source_dir}/selftest02.2mg",
          "{source_dir}/selftest03.2mg",
          "{source_dir}/selftest04.2mg",
          "{source_dir}/selftest05.2mg",
          "{source_dir}/selftest06.2mg",
          "{source_dir}/selftest07.2mg",
          "{source_dir}/selftest08.2mg",
          "{source_dir}/selftest09.2mg",
          "{source_dir}/selftest0a.2mg",
          "{source_dir}/selftest0b.2mg",
          "{source_dir}/selftest0c.2mg",
          "{source_dir}/floppy_rw_525.woz",
          "{source_dir}/floppy_rw_35.woz"
        ]
      },
      "command": []
    },
