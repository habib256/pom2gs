      "title": "TextFunk Viewer live text-page beam race",
      "tier": "external-user-supplied",
      "readiness": "blocked-live-scanout",
      "domains": ["cpu65816", "fpi-cya", "mega2", "vgc", "shadowing"],
      "asset_policy": "user-supplied",
      "assets": [
        {"name": "Legally obtained textfunk.po", "env": "POMIIGS_TEXTFUNK_DISK"},
